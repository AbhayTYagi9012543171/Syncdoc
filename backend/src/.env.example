# Server Configuration
NODE_ENV=development
PORT=4000
SOCKET_PORT=4001
CORS_ORIGIN=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/syncdoc
MONGODB_USER=admin
MONGODB_PASSWORD=password

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=password

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=7d
REFRESH_TOKEN_SECRET=your-super-secret-refresh-key-change-this-in-production

# Email (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# AWS (for file storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Security
BCRYPT_ROUNDS=10
SESSION_SECRET=your-session-secret
# Production hardening
APP_VERSION=2.0.0
GLOBAL_RATE_LIMIT=1200
CORS_ORIGIN=http://localhost:3000

# Optional AI assistant (OpenAI-compatible Chat Completions API)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=45000
AI_RATE_LIMIT_PER_MINUTE=10
TRUST_PROXY=1
