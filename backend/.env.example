# SyncDoc local development
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/syncdoc
JWT_SECRET=replace-this-with-a-long-random-secret-before-deployment
JWT_EXPIRY=7d
REFRESH_TOKEN_SECRET=replace-this-with-another-long-random-secret
LOG_LEVEL=info

# Optional AI assistant (OpenAI-compatible Chat Completions API)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=45000
AI_RATE_LIMIT_PER_MINUTE=10
TRUST_PROXY=1
