# SyncDoc local development
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/syncdoc
JWT_SECRET=replace-this-with-a-long-random-secret-before-deployment
JWT_EXPIRY=7d
REFRESH_TOKEN_SECRET=replace-this-with-another-long-random-secret
LOG_LEVEL=info
REDIS_URL=

# Optional AI assistant (OpenAI-compatible Chat Completions API)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=45000
AI_RATE_LIMIT_PER_MINUTE=10

# Rate limiting (normal API traffic; authentication has separate endpoint limits)
APP_VERSION=6.2.0
GLOBAL_RATE_LIMIT=1200
DEV_GLOBAL_RATE_LIMIT=50000

# Local development: 0. Render single-hop proxy: set TRUST_PROXY=1 in Render.
# Use the exact trusted proxy hop count/range for your deployment; avoid true.
TRUST_PROXY=0
